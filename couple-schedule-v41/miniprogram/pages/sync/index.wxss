.title{font-size:32rpx;font-weight:800}.room-card input{border:1rpx solid #efd6e1;border-radius:16rpx;padding:20rpx;margin-top:14rpx;background:#fffafd}.modes{display:flex;background:#f9edf2;border-radius:18rpx;padding:6rpx;gap:6rpx}.modes button{flex:1;background:transparent;border-radius:14rpx;font-size:26rpx;color:#816b76}.modes .on{background:#fff;color:#c95380;box-shadow:0 4rpx 14rpx rgba(207,83,128,.12)}.primary{margin-top:22rpx;background:linear-gradient(90deg,#f58ab3,#87cdf2);color:#fff;border-radius:17rpx;font-weight:700}.connected{display:flex;justify-content:space-between;align-items:center;background:linear-gradient(135deg,#fff0f6,#ecf8ff);border-radius:20rpx;padding:22rpx;margin-top:20rpx}.connected-label,.room-code{display:block}.connected-label{font-size:22rpx;color:#9a8590}.room-code{font-size:34rpx;font-weight:800;margin-top:4rpx}.badge{padding:8rpx 16rpx;border-radius:999rpx;background:#ddf8e8;color:#318255;font-size:22rpx}.actions{display:flex;gap:16rpx;margin-top:22rpx}.actions button{flex:1;background:#f889b3;color:#fff;border-radius:16rpx}.leave{margin-top:14rpx;background:#fff2f5;color:#c9577f;border-radius:16rpx;font-size:24rpx}.status,.last,.file-status{display:block;margin-top:18rpx;color:#39835b;font-size:24rpx;line-height:1.5}.last{color:#9b8892;margin-top:8rpx}.row{display:flex;align-items:center;justify-content:space-between;padding:22rpx 0;border-bottom:1rpx solid #f4e8ed;font-size:27rpx}.row:last-child{border:0}.row text,.row small{display:block}.row small{font-size:22rpx;color:#9b8892;margin-top:6rpx}.file-actions button{margin-top:14rpx;background:#fff0f6;color:#c75580;border-radius:16rpx;font-size:26rpx}.invite-banner{margin:20rpx 0;padding:20rpx;border-radius:18rpx;background:var(--skin-cat-soft);color:var(--skin-cat-ink);font-size:25rpx;line-height:1.5}.invite-banner text{display:block}.invite-banner button{margin-top:14rpx;font-size:24rpx;background:var(--skin-card);color:var(--skin-cat)}.invite-button{margin-top:18rpx;background:var(--skin-cat);color:var(--skin-on-cat);border-radius:18rpx;font-size:27rpx;font-weight:700}.invite-note{display:block;margin-top:14rpx;color:var(--skin-muted);font-size:22rpx;line-height:1.6}.message-heading{display:flex;align-items:center;gap:20rpx}.message-heart{font-size:62rpx;color:var(--skin-cat);line-height:1}
