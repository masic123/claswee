@import "styles/skins.wxss";
page{background:#fff8fb;color:#513e4b;font-family:-apple-system,BlinkMacSystemFont,"Microsoft YaHei","PingFang SC",sans-serif;padding-bottom:calc(122rpx + env(safe-area-inset-bottom));box-sizing:border-box}button,input,picker{font-family:-apple-system,BlinkMacSystemFont,"Microsoft YaHei","PingFang SC",sans-serif}button{font-size:28rpx}.card{background:#fff;border-radius:28rpx;margin:24rpx;padding:28rpx;box-shadow:0 8rpx 25rpx rgba(236,146,180,.12)}

/* 课表页下拉控件 */
.hero{position:relative;z-index:12}.schedule-controls{display:flex;align-items:center;justify-content:center;gap:12rpx;margin-top:12rpx}.control-picker{position:relative}.control-trigger{display:flex;align-items:center;gap:7rpx;height:58rpx;padding:0 18rpx;border-radius:999rpx;background:rgba(255,255,255,.88);color:#584550;font-size:21rpx;font-weight:700;box-shadow:0 4rpx 13rpx rgba(124,84,103,.10)}.control-trigger b{max-width:118rpx;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:#b34d75}.control-icon{color:#e56f9b}.grid-icon{color:#5faee3}.control-chevron{color:#927e89;font-size:22rpx}.control-menu{position:absolute;top:66rpx;left:50%;z-index:14;width:220rpx;padding:8rpx;transform:translateX(-50%);border:1rpx solid #f0dce5;border-radius:18rpx;background:rgba(255,255,255,.98);box-shadow:0 14rpx 34rpx rgba(91,57,74,.17)}.control-menu button{display:flex;align-items:center;justify-content:space-between;width:100%;height:62rpx;padding:0 18rpx;border-radius:13rpx;background:transparent;color:#806c76;font-size:23rpx;text-align:left}.control-menu button.on{background:linear-gradient(90deg,#fff0f6,#eef8ff);color:#a8446b;font-weight:800}.control-menu .menu-check{color:#ef76a4;opacity:0}.control-menu button.on .menu-check{opacity:1}.menu-backdrop{position:fixed;z-index:11;inset:0;background:transparent}


/* 男女课表中轴时间 */
.lanes{align-items:flex-start}.lane-name,.axis-title{height:34rpx;line-height:34rpx;margin-bottom:7rpx}.time-axis-wrap{width:66rpx;flex:none}.axis-title{text-align:center;color:#9b8791;font-size:18rpx}.time-axis{position:relative;height:760rpx}.time-axis-line{position:absolute;left:50%;top:0;bottom:0;width:2rpx;transform:translateX(-50%);background:#ead7df}.time-tick{position:absolute;left:50%;z-index:2;transform:translate(-50%,-50%);padding:3rpx 5rpx;border-radius:7rpx;background:#fff8fb;color:#8d7782;font-size:18rpx;line-height:1;white-space:nowrap}

/* Nickname colors stay consistent, including selected owner controls. */
.nick-cat{color:#d94f8a!important}
.nick-dog{color:#257fbd!important}
.choice button.on.cat,.owners button.on.cat{background:#ffe3ee!important}
.choice button.on.dog,.owners button.on.dog{background:#dff1ff!important}
page{background:transparent;padding-bottom:0}
