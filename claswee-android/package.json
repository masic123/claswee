    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@phosphor-icons/vue": "2.2.1",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@vitejs/plugin-vue": "6.0.10",
    "vite": "8.3.5"
  }
}
