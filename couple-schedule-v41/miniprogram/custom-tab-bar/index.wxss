.tabbar{position:fixed;left:0;right:0;bottom:0;z-index:999;background:rgba(255,255,255,.96);border-top:1rpx solid #f1dfe7;padding-bottom:env(safe-area-inset-bottom);box-shadow:0 -8rpx 28rpx rgba(111,72,91,.07)}
.tabbar-inner{height:116rpx;display:flex;align-items:center;justify-content:space-around}
.tab{width:33.333%;height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#8d7b85;font-size:21rpx;font-weight:700;gap:5rpx;box-sizing:border-box}
.icon-shell{position:relative;width:72rpx;height:60rpx;border-radius:23rpx;display:flex;align-items:center;justify-content:center;border:2rpx solid rgba(255,255,255,.95);box-shadow:inset 0 2rpx 0 rgba(255,255,255,.98),0 5rpx 12rpx rgba(132,93,111,.10);transform:scale(.92);transition:transform .18s ease,box-shadow .18s ease}
.shine{position:absolute;left:12rpx;right:12rpx;top:6rpx;height:14rpx;border-radius:999rpx;background:linear-gradient(180deg,rgba(255,255,255,.9),rgba(255,255,255,0))}
.icon-schedule{background:linear-gradient(145deg,#fffefd,#fff0f5);border-color:#ffe2ec}.icon-settings{background:linear-gradient(145deg,#fffefd,#f3eeff);border-color:#eae1ff}.icon-sync{background:linear-gradient(145deg,#fff,#eaf6ff);border-color:#dceffd}
.active .icon-shell{transform:translateY(-2rpx) scale(1)}.tab-schedule{color:#a95776}.tab-settings.active{color:#7661a8}.tab-schedule.active{color:#bd4f78}.tab-sync.active{color:#2874a2}
.tab-settings.active .icon-shell{background:linear-gradient(145deg,#fcfaff,#eee8fc);box-shadow:inset 0 2rpx 0 #fff,0 8rpx 18rpx rgba(180,157,231,.26)}.tab-schedule.active .icon-shell{background:linear-gradient(145deg,#fff9fc,#ffe7f0);box-shadow:inset 0 2rpx 0 #fff,0 9rpx 21rpx rgba(255,143,177,.27)}.tab-sync.active .icon-shell{background:linear-gradient(145deg,#f9fdff,#e0f2fd);box-shadow:inset 0 2rpx 0 #fff,0 8rpx 18rpx rgba(95,174,227,.25)}
.tab.primary .icon-shell{width:84rpx;height:70rpx;transform:translateY(-8rpx) scale(1);border-radius:26rpx;box-shadow:inset 0 2rpx 0 #fff,0 9rpx 20rpx rgba(255,143,177,.22)}.tab.primary.active .icon-shell{transform:translateY(-11rpx) scale(1.06)}.tab.primary .tab-label{margin-top:-8rpx;font-size:23rpx;font-weight:800}
.tab-pressed .icon-shell{transform:scale(.86)}
.calendar{position:relative;width:42rpx;height:36rpx;border-radius:9rpx;background:#fff9fc;border:2rpx solid rgba(255,119,160,.35);box-shadow:0 4rpx 9rpx rgba(255,105,151,.28);overflow:visible}
.calendar-top{height:13rpx;border-radius:7rpx 7rpx 1rpx 1rpx;background:linear-gradient(180deg,#ff8cb0,#ff6f9c)}
.calendar-ring{position:absolute;top:-8rpx;width:6rpx;height:13rpx;border-radius:6rpx;background:#fff8fb;border:2rpx solid #f6aec5;box-shadow:0 2rpx 4rpx rgba(229,96,139,.18)}.ring-left{left:8rpx}.ring-right{right:8rpx}
.calendar-grid{display:grid;grid-template-columns:repeat(3,6rpx);gap:5rpx;margin:7rpx 0 0 8rpx}.calendar-grid view{width:6rpx;height:6rpx;border-radius:2rpx;background:#ffc4d6}.calendar-heart{position:absolute;right:-11rpx;bottom:-12rpx;color:#ff5f91;font-size:23rpx;line-height:1;text-shadow:0 4rpx 7rpx rgba(255,95,145,.34)}
.gear,.cloud{width:50rpx;height:50rpx;display:flex;align-items:center;justify-content:center}.gear text,.cloud text{font-family:"Segoe UI Symbol","Arial Unicode MS",sans-serif;line-height:1}.gear text{color:#a88af2;font-size:50rpx;text-shadow:0 2rpx 0 #fff,0 5rpx 10rpx rgba(139,111,223,.34)}.cloud text{color:#82b8f5;font-size:50rpx;text-shadow:0 2rpx 0 #fff,0 6rpx 10rpx rgba(77,145,226,.28)}.tab-label{line-height:1.1}

/* 自定义 tabBar 是独立组件，单独接收本机皮肤。 */
.tabbar.skin-blush{--tab-bg:#fff;--tab-card:#fff;--tab-muted:#8d7b85;--tab-line:#f1dfe7;--tab-cat:#bd4f78;--tab-cat-soft:#fff0f6;--tab-dog:#2874a2;--tab-dog-soft:#eaf6ff;--tab-setting:#a88af2;--tab-setting-soft:#f3eeff}
.tabbar.skin-mint{--tab-bg:#fff;--tab-card:#fff;--tab-muted:#627a73;--tab-line:#dceae3;--tab-cat:#b9533f;--tab-cat-soft:#fcebe5;--tab-dog:#2e8177;--tab-dog-soft:#e2f4ed;--tab-setting:#b9533f;--tab-setting-soft:#fcebe5}
.tabbar.skin-sun{--tab-bg:#fffdf8;--tab-card:#fffdf8;--tab-muted:#806f56;--tab-line:#ede1c8;--tab-cat:#9e651e;--tab-cat-soft:#fff0cf;--tab-dog:#526d98;--tab-dog-soft:#eaf0fa;--tab-setting:#9e651e;--tab-setting-soft:#fff0cf}
.tabbar.skin-night{--tab-bg:#17243d;--tab-card:#1b2b47;--tab-muted:#acbbd2;--tab-line:#2b3a57;--tab-cat:#c29bf8;--tab-cat-soft:#3b2f58;--tab-dog:#6cd5cc;--tab-dog-soft:#24484f;--tab-setting:#c29bf8;--tab-setting-soft:#3b2f58}
.tabbar{background:var(--tab-bg);border-color:var(--tab-line)}
.tab{color:var(--tab-muted)}
.tab-schedule,.tab-schedule.active{color:var(--tab-cat)}
.tab-settings.active{color:var(--tab-setting)}
.tab-sync.active{color:var(--tab-dog)}
.icon-shell{box-shadow:0 5rpx 12rpx rgba(0,0,0,.1);border-color:var(--tab-line)}
.icon-schedule,.tab-schedule.active .icon-shell{background:var(--tab-cat-soft);border-color:var(--tab-line);box-shadow:0 7rpx 16rpx rgba(0,0,0,.1)}
.icon-settings,.tab-settings.active .icon-shell{background:var(--tab-setting-soft);border-color:var(--tab-line);box-shadow:0 7rpx 16rpx rgba(0,0,0,.1)}
.icon-sync,.tab-sync.active .icon-shell{background:var(--tab-dog-soft);border-color:var(--tab-line);box-shadow:0 7rpx 16rpx rgba(0,0,0,.1)}
.tab.primary .icon-shell{box-shadow:0 7rpx 18rpx rgba(0,0,0,.12)}
.calendar{background:var(--tab-card);border-color:var(--tab-cat);box-shadow:none}
.calendar-top{background:var(--tab-cat)}
.calendar-ring{background:var(--tab-card);border-color:var(--tab-cat);box-shadow:none}
.calendar-grid view{background:var(--tab-cat-soft)}
.calendar-heart{color:var(--tab-cat);text-shadow:none}
.gear text{color:var(--tab-setting);text-shadow:none}
.cloud text{color:var(--tab-dog);text-shadow:none}
.tabbar.skin-night .shine{opacity:.22}
