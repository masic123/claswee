.label{margin:26rpx 0 12rpx;font-weight:700}.card .text-input{height:78rpx;line-height:78rpx;background:#fff7fa;border:1rpx solid #f3d9e4;border-radius:16rpx;padding:0 20rpx;font-size:28rpx;font-family:"Microsoft YaHei","PingFang SC",sans-serif;font-weight:400;box-sizing:border-box}.form-placeholder{color:#9b8b94;font-family:"Microsoft YaHei","PingFang SC",sans-serif;font-size:27rpx;font-weight:400;line-height:78rpx}.slot picker view,.custom picker view{background:#fff7fa;border:1rpx solid #f3d9e4;border-radius:16rpx;padding:20rpx;font-size:28rpx;box-sizing:border-box}.choice{display:flex;gap:14rpx}.choice button{flex:1;background:#f8eff3;font-size:25rpx}.choice .on{background:#ef76a4;color:#fff}.choice .cat.on{background:#f58eb5}.choice .dog.on{background:#6fc0ec}.slot{display:flex;align-items:center;gap:10rpx;margin:12rpx 0}.slot picker{flex:1;min-width:0}.slot picker view{padding:17rpx 9rpx;text-align:center}.remove{width:62rpx;min-width:62rpx;padding:0;background:#fff0f4;color:#dc638c;border-radius:16rpx;font-size:38rpx}.add-slot{margin-top:10rpx;background:#fff0f6;color:#cf5e89;border-radius:16rpx;font-size:26rpx}.compact button{padding:14rpx 4rpx}.custom{padding:16rpx;background:#fff5f8;border-radius:18rpx;margin-top:14rpx;display:flex;gap:12rpx;flex-wrap:wrap}.custom picker{width:calc(50% - 6rpx)}.custom picker view{padding:16rpx}.parity{width:100%}.save,.delete{margin-top:34rpx;background:#f580aa;color:#fff;border-radius:16rpx}.delete{margin-top:16rpx;background:#fff0f3;color:#d94f79}
.import-title{font-size:32rpx;font-weight:800;margin-bottom:22rpx}.import-option{display:flex;flex-direction:column;align-items:flex-start;text-align:left;width:100%;height:auto;padding:24rpx;margin-top:18rpx;background:#fff5f9;border:1rpx solid #f3d9e4;border-radius:18rpx;line-height:1.5}.import-option-title{font-size:29rpx;font-weight:700;color:#42343d}.import-option-hint,.import-description{display:block;font-size:24rpx;color:#927e89;line-height:1.6}.import-description{margin-bottom:24rpx}.import-primary{background:#f580aa;color:#fff;border-radius:16rpx}.import-back{margin-top:18rpx;background:#fff0f6;color:#c75580;border-radius:16rpx;font-size:25rpx}.import-back-top{margin-top:0;margin-bottom:20rpx}
