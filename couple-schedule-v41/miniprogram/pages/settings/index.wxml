<view class="app-skin skin-{{skin}}">
<view class="card skin-card">
  <view class="title">课表皮肤</view>
  <view class="skin-grid">
    <button wx:for="{{skinOptions}}" wx:key="value" data-skin="{{item.value}}" bindtap="chooseSkin" class="skin-option preview-{{item.value}} {{skin===item.value?'on':''}}" aria-label="{{item.name}}皮肤">
      <view class="skin-mini" aria-hidden="true"><view class="mini-head"><view></view><view></view><view></view></view><view class="mini-cat"></view><view class="mini-dog"></view></view>
      <text>{{item.name}}</text>
    </button>
  </view>
</view>
<view class="card wechat-card"><view class="title">{{me==='cat'?catName:dogName}}的头像与昵称</view><view class="wechat-profile"><button class="wechat-avatar" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" bindtap="onWechatAvatarTap" disabled="{{avatarSaving}}"><image wx:if="{{wechatAvatarIsImage}}" src="{{wechatAvatar}}" mode="aspectFill"/><text wx:else>{{wechatAvatar}}</text></button><input class="nickname nick-{{me}}" type="nickname" value="{{wechatNickname}}" placeholder="点击选择微信昵称" bindblur="useWechatNickname" /></view><view class="avatar-actions"><button class="wechat-choose" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" bindtap="onWechatAvatarTap" disabled="{{avatarSaving}}">选择微信头像</button><button class="album-choose" data-owner="{{me}}" bindtap="uploadAvatar" disabled="{{avatarSaving}}">从相册选择头像</button></view><text wx:if="{{avatarHelp}}" class="hint avatar-help">{{avatarHelp}}</text></view>
<view class="card"><view class="title">我们俩</view><view class="person"><view class="avatar" data-owner="cat" bindtap="avatar"><image wx:if="{{catIsImage}}" src="{{catAvatar}}" mode="aspectFill"/><text wx:else>{{catAvatar}}</text></view><input class="nick-cat" value="{{catName}}" data-key="catName" bindblur="input" /></view><view class="person"><view class="avatar dog-bg" data-owner="dog" bindtap="avatar"><image wx:if="{{dogIsImage}}" src="{{dogAvatar}}" mode="aspectFill"/><text wx:else>{{dogAvatar}}</text></view><input class="nick-dog" value="{{dogName}}" data-key="dogName" bindblur="input" /></view><view class="label">我是谁</view><view class="choice"><button data-owner="cat" bindtap="chooseMe" class="{{me==='cat'?'on cat':''}}"><text class="nick-cat">{{catName}}</text></button><button data-owner="dog" bindtap="chooseMe" class="{{me==='dog'?'on dog':''}}"><text class="nick-dog">{{dogName}}</text></button></view></view>
<view class="card">
  <view class="title">学期设置</view>
  <view class="row"><text><text class="nick-cat">{{catName}}</text>　第一周周一</text><picker mode="multiSelector" range="{{catStartRange}}" value="{{catStartValue}}" data-owner="cat" bindcolumnchange="changeStartColumn" bindcancel="cancelStartPicker" bindchange="setCatStart"><view>{{catStart}} ›</view></picker></view>
  <text wx:if="{{catStartInvalid}}" class="hint">{{catName}}的原起始日期不是周一，请重新选择。</text>
  <view class="row"><text><text class="nick-dog">{{dogName}}</text>　第一周周一</text><picker mode="multiSelector" range="{{dogStartRange}}" value="{{dogStartValue}}" data-owner="dog" bindcolumnchange="changeStartColumn" bindcancel="cancelStartPicker" bindchange="setDogStart"><view>{{dogStart}} ›</view></picker></view>
  <text wx:if="{{dogStartInvalid}}" class="hint">{{dogName}}的原起始日期不是周一，请重新选择。</text>
  <view class="row"><text>总周数</text><picker mode="selector" range="{{weekOptions}}" value="{{weeks-1}}" bindchange="setWeeks"><view>{{weeks}} 周 ›</view></picker></view>
</view>
<view class="card"><view class="title">调休与补课</view><text wx:if="{{adjustmentKind==='use'}}" class="hint">若原日期停课，请将原日期另设为休息。</text><view class="row"><text>调整日期</text><picker mode="date" value="{{adjustmentDate}}" start="{{adjustmentMinDate}}" end="{{adjustmentMaxDate}}" bindchange="setAdjustmentDate"><view>{{adjustmentDate}} ›</view></picker></view><view class="label">谁的课表</view><view class="choice"><button data-owner="both" bindtap="chooseAdjustmentOwner" class="{{adjustmentOwner==='both'?'on':''}}">两个人</button><button data-owner="cat" bindtap="chooseAdjustmentOwner" class="{{adjustmentOwner==='cat'?'on cat':''}}">{{catName}}</button><button data-owner="dog" bindtap="chooseAdjustmentOwner" class="{{adjustmentOwner==='dog'?'on dog':''}}">{{dogName}}</button></view><view class="label">当天安排</view><view class="choice"><button data-kind="off" bindtap="chooseAdjustmentKind" class="{{adjustmentKind==='off'?'on':''}}">休息，不上课</button><button data-kind="use" bindtap="chooseAdjustmentKind" class="{{adjustmentKind==='use'?'on':''}}">按另一日上课</button></view><view wx:if="{{adjustmentKind==='use'}}" class="row"><text>参照哪天的课表</text><picker mode="date" value="{{adjustmentSourceDate}}" start="{{adjustmentMinDate}}" end="{{adjustmentMaxDate}}" bindchange="setAdjustmentSourceDate"><view>{{adjustmentSourceDate}} ›</view></picker></view><button class="soft" bindtap="saveAdjustment">保存这天的安排</button><view wx:if="{{adjustmentRows.length}}" class="label">已设置的日期</view><view wx:for="{{adjustmentRows}}" wx:key="key" class="adjustment-item"><view><text class="adjustment-item-date">{{item.date}} · {{item.ownerName}}</text><text class="adjustment-item-detail">{{item.description}}</text></view><button data-key="{{item.key}}" bindtap="removeAdjustment" aria-label="删除这条调休安排">删除</button></view></view>
<view class="card"><view class="title">节次时间</view><view class="choice"><button data-owner="cat" bindtap="switchOwner" class="{{sectionOwner==='cat'?'on cat':''}}"><text class="nick-cat">{{catName}}</text></button><button data-owner="dog" bindtap="switchOwner" class="{{sectionOwner==='dog'?'on dog':''}}"><text class="nick-dog">{{dogName}}</text></button></view><block wx:for="{{sections}}" wx:key="index"><view class="section" wx:if="{{sectionsExpanded || index < 4}}"><text>第{{index+1}}节</text><picker mode="time" value="{{item.s}}" data-index="{{index}}" data-key="s" bindchange="setTime"><view>{{item.s}}</view></picker><text>至</text><picker mode="time" value="{{item.e}}" data-index="{{index}}" data-key="e" bindchange="setTime"><view>{{item.e}}</view></picker><button data-index="{{index}}" bindtap="removeSection">×</button></view></block><button wx:if="{{sections.length > 4}}" class="soft" bindtap="toggleSections">{{sectionsExpanded ? '收起' : '展开全部节次'}}</button><button class="soft" bindtap="addSection">＋ 添加一节</button><view class="label">休息分隔位置（两人共用）</view><block wx:if="{{breakSectionCount > 1}}"><view class="row"><text>午休</text><picker mode="selector" range="{{lunchOptions}}" value="{{lunchAfter-1}}" data-key="lunchAfter" bindchange="setBreak"><view>第{{lunchAfter}}节后 ›</view></picker></view><view class="row"><text>晚休</text><picker mode="selector" range="{{dinnerOptions}}" value="{{dinnerAfter-2}}" data-key="dinnerAfter" bindchange="setBreak"><view>第{{dinnerAfter}}节后{{dinnerAfter===breakSectionCount?'（末节，不显示）':''}} ›</view></picker></view></block><text wx:else class="hint">至少添加两节课，才能设置休息位置。</text></view>
<view class="card danger"><view class="title">数据</view><button bindtap="clear">清空所有课程</button><button bindtap="reset">恢复默认设置与示例课表</button></view>
<view wx:if="{{emojiSheet}}" class="mask" bindtap="closeAvatar"><view class="sheet" catchtap="noop"><view class="sheet-title">选择头像</view><view class="emojis"><button wx:for="{{emojis}}" wx:key="*this" data-emoji="{{item}}" bindtap="chooseEmoji">{{item}}</button></view><button class="upload" bindtap="uploadAvatar" loading="{{avatarSaving}}" disabled="{{avatarSaving}}">从相册选择图片</button></view></view>
</view>
<message-note id="messageNote" />
