.poster-page{padding:1rpx 0 50rpx}.title{font-size:34rpx;font-weight:800}.poster-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx;padding:22rpx 0;border-top:1rpx solid var(--skin-line);font-size:26rpx}.poster-row text{display:block}.poster-row picker{color:var(--skin-cat);white-space:nowrap}.poster-preview{display:block;width:calc(100% - 36rpx);margin:20rpx 18rpx;border-radius:22rpx;box-shadow:var(--skin-shadow)}.poster-status{padding:50rpx 30rpx;text-align:center;color:var(--skin-muted);font-size:25rpx}.poster-status text{display:block}.poster-status button{margin-top:16rpx;background:var(--skin-card);color:var(--skin-cat)}.poster-actions{display:flex;gap:16rpx;margin:24rpx 18rpx 12rpx}.poster-actions button{flex:1;background:var(--skin-card);color:var(--skin-cat);border:1rpx solid var(--skin-line);border-radius:18rpx;font-size:27rpx}.poster-actions .primary{background:var(--skin-cat);color:var(--skin-on-cat);border-color:var(--skin-cat)}.poster-canvas{position:fixed;left:-10000px;top:0;width:450px;pointer-events:none}
