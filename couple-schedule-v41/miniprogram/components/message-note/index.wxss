@import "../../styles/skins.wxss";
.note-backdrop{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;padding:38rpx;box-sizing:border-box;background:rgba(55,35,48,.35)}.note-paper{position:relative;width:100%;max-width:640rpx;box-sizing:border-box;padding:46rpx 34rpx 20rpx;border-radius:30rpx;background:var(--skin-card);color:var(--skin-text);box-shadow:0 24rpx 80rpx rgba(58,33,49,.22);border:1rpx solid var(--skin-line);animation:note-in .24s ease-out}.note-tape{position:absolute;top:-15rpx;left:50%;width:124rpx;height:35rpx;transform:translateX(-50%) rotate(-4deg);border-radius:7rpx;background:var(--skin-cat-soft);border:1rpx solid var(--skin-line);opacity:.95}.from-dog .note-tape{background:var(--skin-dog-soft);transform:translateX(-50%) rotate(4deg)}.note-heading{display:flex;align-items:center;gap:12rpx;margin:14rpx 0 10rpx;font-size:33rpx;font-weight:800;line-height:1.5}.note-heart{font-size:43rpx;font-weight:400;color:var(--skin-cat)}.from-dog .note-heart{color:var(--skin-dog)}.note-date{display:block;font-size:22rpx;color:var(--skin-muted);line-height:1.7}.note-body{height:300rpx;max-height:420rpx;margin:28rpx 0 22rpx;border-top:1rpx dashed var(--skin-line);padding-top:20rpx;line-height:1.9;white-space:pre-wrap;word-break:break-all;font-size:29rpx}.note-body text{display:block}.note-footer{display:flex;align-items:center;justify-content:space-between;gap:12rpx;margin:0 0 26rpx;font-size:22rpx}.note-count{color:var(--skin-muted);font-size:20rpx}.note-primary{margin:18rpx 0 0;padding:8rpx 18rpx;font-size:26rpx;font-weight:700;border-radius:18rpx;color:var(--skin-on-cat);background:var(--skin-cat)}.from-dog .note-primary{color:var(--skin-on-dog);background:var(--skin-dog)}.note-primary[disabled]{opacity:.55}.note-secondary{margin:6rpx 0 0;padding:4rpx 18rpx;font-size:23rpx;color:var(--skin-muted);background:transparent}.note-primary::after,.note-secondary::after{border:0}.note-input{width:100%;height:310rpx;box-sizing:border-box;margin-top:24rpx;padding:24rpx;border:1rpx solid var(--skin-line);border-radius:20rpx;background:var(--skin-input);color:var(--skin-text);font-size:28rpx;line-height:1.8}.note-length{display:block;text-align:right;color:var(--skin-muted);font-size:21rpx;margin-top:8rpx}.note-error{display:block;color:var(--skin-cat-ink);font-size:23rpx;line-height:1.6;margin-top:12rpx}
@keyframes note-in{from{opacity:0;transform:translateY(18rpx) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
