.page{padding:24rpx 24rpx 120rpx}.card{background:#fff;border-radius:26rpx;padding:26rpx;margin-bottom:20rpx;box-shadow:0 7rpx 22rpx rgba(190,105,137,.09)}.title{font-size:32rpx;font-weight:800}.hint{display:block;color:#9f8a94;font-size:24rpx;line-height:1.6;margin:12rpx 0 18rpx}.label{font-size:25rpx;font-weight:700;margin-bottom:10rpx}.owners{display:flex;gap:14rpx}.owners button{flex:1;background:#fff3f7;border-radius:999rpx;font-size:25rpx}.owners .on.cat{background:#f68daf;color:#fff}.owners .on.dog{background:#72bee9;color:#fff}.image-picker,.recognize,.confirm{margin-top:20rpx;background:#fff2f7;color:#b54f77;border-radius:18rpx;font-weight:700}.recognize,.confirm{background:linear-gradient(100deg,#f484ad,#85caee);color:#fff}.preview{width:100%;max-height:720rpx;margin-top:20rpx;border-radius:18rpx;background:#f8f2f5}.status{display:block;color:#846e79;font-size:24rpx;margin-top:14rpx;line-height:1.5}.warnings{background:#fff9e8;color:#8e6a25;font-size:23rpx}.warnings text{display:block;margin:5rpx 0}.course-review{padding:18rpx 0;border-bottom:1rpx solid #f2e5eb}.course-review:last-of-type{border-bottom:0}.review-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:10rpx;font-weight:700}.review-head button{margin:0;padding:4rpx 13rpx;background:#fff1f3;color:#c55b73;font-size:22rpx}.course-review input,.pick-row picker{background:#fff8fb;border-radius:12rpx;padding:13rpx 15rpx;margin:8rpx 0;font-size:24rpx;box-sizing:border-box}.pick-row{display:grid;grid-template-columns:repeat(2,1fr);gap:10rpx}.pick-row picker{margin:0}.extra,.warning{display:block;font-size:22rpx;margin-top:9rpx}.extra{color:#8e7a84}.warning{color:#bf7a31}.confirm{width:100%;margin-top:24rpx}
.slot-review{margin:8rpx 0}.slot-review .suggestion{display:block;box-sizing:border-box;width:100%;margin:7rpx 0 12rpx;padding:12rpx 16rpx;background:#fff4df;color:#94631d;border:1rpx solid #f1d4a0;border-radius:12rpx;font-size:22rpx;line-height:1.5;white-space:normal}
.review-field{min-width:0;margin:8rpx 0}.field-label{display:block;color:#8e7a84;font-size:22rpx;margin:0 0 5rpx}.review-field picker{box-sizing:border-box;width:100%;margin:0;padding:13rpx 15rpx;background:#fff8fb;border-radius:12rpx;font-size:24rpx}.review-field picker view{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.frequency-field{margin-top:15rpx}.week-default-note{display:block;margin:8rpx 0 10rpx;padding:10rpx 14rpx;border-radius:12rpx;background:#fff4df;color:#94631d;font-size:22rpx;line-height:1.5}
